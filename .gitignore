@'
# Dependencies
**/node_modules/
**/node_modules.*/
**/node_modules-*/

# Build files
**/dist/
**/build/
**/.next/
**/coverage/

# Environment variables and secrets
.env
.env.*
!.env.example

# Database files (local development)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Cache
.cache/
.vite/
__pycache__/
*.pyc

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
'@ | Set-Content -Encoding utf8 .gitignore